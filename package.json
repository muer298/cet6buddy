{
  "name": "cet6-buddy",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start:api": "node --env-file-if-exists=.env dist/server/index.js",
    "db:check": "node --env-file-if-exists=.env server/check-db.ts",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env server/bootstrap-admin.ts",
    "content:seed": "node --env-file-if-exists=.env server/seed-pilot-content.ts",
    "test:server": "node --test server/app.test.ts server/learning-regression.test.ts",
    "test:learning": "node scripts/test-learning-flow.ts",
    "test:learning:mysql": "node --env-file-if-exists=.env scripts/test-learning-mysql.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "cos-js-sdk-v5": "1.10.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "mysql2": "3.24.5",
    "qcloud-cos-sts": "3.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "overrides": {
    "fast-xml-parser": "5.7.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vite-plugin-pwa": "2.0.0"
  }
}
