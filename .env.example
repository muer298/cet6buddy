PORT=8787
HOST=127.0.0.1
VITE_API_BASE_URL=http://127.0.0.1:8787

# memory（零配置演示）或 mysql（本地/线上持久化）
STORAGE_DRIVER=memory

# 推荐：部署平台通常直接提供 DATABASE_URL。不要提交真实密码。
# DATABASE_URL=mysql://cet6_user:change-me@127.0.0.1:3306/cet6_buddy

# 也可以分项配置；DATABASE_URL 存在时优先使用它。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cet6_buddy
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=10
DB_SSL=false
# 仅本地自签名证书可设为 true；线上不建议。
DB_SSL_ALLOW_SELF_SIGNED=false

# 账号与邮箱验证码。生产环境必须替换 AUTH_CODE_SECRET，并关闭验证码回显。
AUTH_CODE_SECRET=replace-with-at-least-32-random-characters
AUTH_EXPOSE_CODE=true
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:4173
EMAIL_DRIVER=development

# 线上改为 EMAIL_DRIVER=tencent-ses，并配置腾讯云 SES。
SES_REGION=ap-hongkong
SES_FROM_EMAIL=
SES_TEMPLATE_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ADMIN_EMAILS=

# 腾讯云 COS（生产环境）
UPLOAD_DRIVER=local
COS_REGION=ap-hongkong
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
TENCENT_APP_ID=
LOCAL_UPLOAD_DIR=/private/tmp/cet6-buddy-uploads
