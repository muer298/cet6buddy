[Unit]
Description=CET6 Buddy API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cet6
Group=cet6
WorkingDirectory=/opt/cet6-buddy/current
EnvironmentFile=/etc/cet6-buddy/production.env
ExecStart=/usr/bin/node --env-file=/etc/cet6-buddy/production.env dist/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cet6-buddy

[Install]
WantedBy=multi-user.target
